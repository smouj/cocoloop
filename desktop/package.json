{
  "name": "cocoloop",
  "productName": "CocoLoop",
  "version": "0.3.0",
  "description": "CocoLoop · CL Studio desktop shell",
  "main": "main.js",
  "author": {
    "name": "SMOUJ",
    "email": "smouj@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.smouj.cocoloop",
    "productName": "CocoLoop",
    "copyright": "Copyright © 2026 CocoLoop Contributors",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/server",
        "to": "server",
        "filter": [
          "*.exe"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "CocoLoop-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CocoLoop",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
